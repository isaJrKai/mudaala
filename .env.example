# Mudaala — environment template.
# Copy to .env and fill in real values. .env is git-ignored; never commit
# real secrets. CI (.github/workflows/ci.yml) mirrors this shape with
# throwaway CI-only values.

# SQLite database file (development). Prisma resolves relative paths
# against prisma/schema.prisma.
DATABASE_URL=file:./db/custom.db

# Comma-separated phone numbers that unlock DEPLOYMENT-level settings
# (see src/lib/admin.ts). Ugandan numbers only (+256). An empty value
# means no admins at all — the route fails closed.
ADMIN_PHONES=+256712000001

# Shared secret that cron routes require via Authorization: Bearer.
# Generate one with: openssl rand -hex 24
CRON_SECRET=generate-a-long-random-string

# Key material for AES-256-GCM encryption of deployment settings at rest.
# Any long random string works (it is hashed to a 256-bit key).
# Generate one with: openssl rand -hex 24
SETTINGS_ENC_KEY=generate-a-long-random-string

# Set to 1 ONLY in local/preview sandboxes: lets Authorization: Bearer
# tokens stand in for cookie sessions. Never enable this in production.
AUTH_BEARER_FALLBACK=0

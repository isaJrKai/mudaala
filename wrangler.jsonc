{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudaala-cloudflare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}

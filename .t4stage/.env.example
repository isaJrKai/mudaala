# Copy to .env and fill real values. NEVER commit the real .env.
# Every value here is a placeholder — the shapes match what CI sets
# (see .github/workflows/ci.yml env block) and what the app expects.

# SQLite runtime store (dev). In production point at a real database.
DATABASE_URL=file:./db/custom.db

# Phone numbers (E.164, Uganda +256 only) that get admin powers.
# Must match a seeded/admin user's normalized phone.
ADMIN_PHONES=+256712000001

# Canonical public origin of the deployment. Ad-page URLs (/l, /s), OG tags,
# the sitemap and robots all anchor to it. Set it to the real domain in
# production.
APP_ORIGIN=https://your-domain.example

# Shared secret for the cron sweep endpoint (POST /api/cron/sweep).
CRON_SECRET=change-me-cron-secret

# SMS gateway for password-reset codes (TASK 3). Production sends via
# Africa's Talking using these credentials. Non-production environments
# simulate delivery to the server console instead and never need these.
# AT_SENDER_ID is optional (omit it to use the gateway's default sender).
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# Key material for encrypting stored PostgreSQL settings at rest (AES-256-GCM).
# Any string works; a long random hex string is recommended.
SETTINGS_ENC_KEY=000000000000000000000000000000000000000000000000

# Local/dev convenience: allow Authorization: Bearer session tokens.
# Keep "1" in dev; CI sets it too. Do not enable on public deployments
# unless you understand the cookie-less channel it opens.
AUTH_BEARER_FALLBACK=1

# Copy to .env and fill real values. NEVER commit the real .env.
# Every value here is a placeholder — the shapes match what CI sets
# (see .github/workflows/ci.yml env block) and what the app expects.
# The app validates this file at startup: in production a missing required
# value refuses to boot (see src/lib/env.ts) instead of failing silently.

# SQLite runtime store (dev). In production point at a real database.
DATABASE_URL=file:./db/custom.db

# Phone numbers (E.164, Uganda +256 only) that get admin powers.
# Required in production — with no allowlist the admin desk fails closed.
ADMIN_PHONES=+256712000001

# Canonical public origin of the deployment. Ad-page URLs, OG tags, the
# sitemap and robots all anchor to it. Required in production.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Shared secret for the cron sweep endpoint (POST /api/cron/sweep).
# The scheduler presents it as the x-cron-secret header. Required in
# production — the endpoint refuses to run without it.
CRON_SECRET=change-me-cron-secret

# Key material for encrypting stored PostgreSQL settings at rest (AES-256-GCM).
# Any string works; a long random hex string is recommended. Required in
# production. SETTINGS_ENC_KEY is the legacy alias and still works.
SETTINGS_ENCRYPTION_KEY=000000000000000000000000000000000000000000000000

# Local/dev convenience: allow Authorization: Bearer session tokens.
# Bearer auth ONLY works when this is truthy; production leaves it unset and
# uses the httpOnly cookie. Legacy alias: AUTH_BEARER_FALLBACK.
ALLOW_BEARER_AUTH=1

# Content-Security-Policy frame-ancestors directive. Default 'self' keeps the
# sandbox/preview iframe working; production deployments should set it to
# "'none'" (no embedding at all) or to the specific parent origin(s) allowed
# to embed the app. X-Frame-Options mirrors 'self'/'none' automatically.
# FRAME_ANCESTORS='none'

# Rate-limit knobs (defaults follow the Task 4 spec) — override only if you
# know why:
#   login     5 failed attempts / phone / 15 min   (RATE_LIMIT_LOGIN_MAX)
#   login     20 attempts / IP / 15 min            (RATE_LIMIT_LOGIN_IP_MAX)
#   register  5 accounts / IP / hour               (RATE_LIMIT_REGISTER_MAX)
#   publish   20 listings / user / day             (RATE_LIMIT_PUBLISH_MAX)
#   upload    30 photos / user / hour              (RATE_LIMIT_UPLOAD_MAX)

# Africa's Talking SMS delivery (password-reset codes). In every
# non-production environment a console provider simulates delivery instead.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

// Commerce OS — data model
// The database is the single source of truth for listings, ownership and status.
// SQLite is the sandbox runtime store; the PostgreSQL deployment connection is
// configured in Settings → Advanced Settings (stored in AppSetting).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  phone        String           @unique // normalized E.164: +2567XXXXXXXX / +2557XXXXXXXX / +2547XXXXXXXX
  name         String
  country      String           @default("UG") // UG | TZ | KE
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sessions      Session[]
  listings      Listing[]
  savedSearches SavedSearch[]
  notifications Notification[]
  profile       BusinessProfile?
}

model Session {
  id        String   @id // opaque random token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model BusinessProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  category     String?
  description  String?
  county       String?
  area         String?
  phone        String
  whatsapp     String?
  hours        String?
  // Verification is NOT offered in V1. This flag stays false and no verified
  // badge is rendered anywhere until a real verification process exists.
  verified     Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Listing {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String // OFFER | REQUEST
  title            String
  description      String
  category         String
  price            Float? // in the listing's currency, null = "ask seller" / not disclosed
  currency         String    @default("UGX") // UGX | TZS | KES
  priceNegotiable  Boolean   @default(false)
  unit             String? // per kg, per bag, ... (null when price is null)
  quantity         Float?
  county           String // district/region name (validated against the listing's country)
  country          String    @default("UG") // UG | TZ | KE
  area             String?
  contactPhone     String // normalized E.164
  contactWhatsapp  String?
  status           String    @default("ACTIVE") // ACTIVE | FULFILLED | EXPIRED | ARCHIVED
  searchText       String    @default("") // lowercased title+description+category+area for SQLite case-insensitive search
  viewCount        Int       @default(0)
  publishedAt      DateTime  @default(now())
  refreshedAt      DateTime  @default(now()) // drives freshness ordering
  expiresAt        DateTime // refreshedAt + LISTING_ACTIVE_DAYS
  expiringNotifiedAt DateTime? // dedup for "expiring soon" notifications
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, refreshedAt])
  @@index([type, status])
  @@index([category, status])
  @@index([county, status])
  @@index([userId, status])
  @@index([expiresAt])
}

model SavedSearch {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  queryJson      String // serialized ListingQuery (shared schema with browse filters)
  lastMatchCount Int      @default(0)
  lastCheckedAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // NEW_MATCH | LISTING_EXPIRED | LISTING_EXPIRING
  title     String
  body      String
  listingId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model AppSetting {
  key       String   @id
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}
